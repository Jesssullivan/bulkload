"""Bazel module for the bulkload migration controller and skill."""

module(
    name = "bulkload",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_python", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12")
register_toolchains("@python_3_12//:all")
