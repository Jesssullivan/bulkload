"""Canonical build and validation graph for bulkload."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "bulkload_lib",
    srcs = [
        ".agents/skills/bulkload/scripts/bulkload_lib/__init__.py",
        ".agents/skills/bulkload/scripts/bulkload_lib/cli.py",
        ".agents/skills/bulkload/scripts/bulkload_lib/executor.py",
        ".agents/skills/bulkload/scripts/bulkload_lib/model.py",
        ".agents/skills/bulkload/scripts/bulkload_lib/planner.py",
        ".agents/skills/bulkload/scripts/bulkload_lib/scanner.py",
    ],
    imports = [".agents/skills/bulkload/scripts"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "bulkload",
    interpreter_args = [
        "-I",
        "-S",
    ],
    legacy_create_init = 0,
    srcs = [".agents/skills/bulkload/scripts/bulkload.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "bulkload_tests",
    legacy_create_init = 0,
    main = "tests/test_bulkload.py",
    size = "large",
    srcs = ["tests/test_bulkload.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "doctor_tests",
    legacy_create_init = 0,
    main = "tests/test_doctor.py",
    size = "small",
    srcs = ["tests/test_doctor.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "wave0_perf_tests",
    imports = ["tests"],
    legacy_create_init = 0,
    main = "tests/test_wave0_perf.py",
    size = "large",
    srcs = [
        "tests/test_bulkload.py",
        "tests/test_wave0_perf.py",
    ],
    deps = [":bulkload_lib"],
)

py_test(
    name = "wave2_memory_tests",
    imports = ["tests"],
    legacy_create_init = 0,
    main = "tests/test_wave2_memory.py",
    size = "large",
    srcs = [
        "tests/test_bulkload.py",
        "tests/test_wave0_perf.py",
        "tests/test_wave2_memory.py",
    ],
    deps = [":bulkload_lib"],
)

py_test(
    name = "custody_source_fold_tests",
    imports = ["tests"],
    legacy_create_init = 0,
    main = "tests/test_custody_source_fold.py",
    size = "large",
    srcs = [
        "tests/test_bulkload.py",
        "tests/test_custody_source_fold.py",
        "tests/test_wave0_perf.py",
    ],
    deps = [":bulkload_lib"],
)

py_test(
    name = "bazel_binary_smoke_test",
    legacy_create_init = 0,
    main = "tests/test_bazel_binary_smoke.py",
    size = "small",
    srcs = ["tests/test_bazel_binary_smoke.py"],
    data = [":bulkload"],
)

py_test(
    name = "runtime_bootstrap_tests",
    legacy_create_init = 0,
    main = "tests/test_runtime_bootstrap.py",
    size = "small",
    srcs = ["tests/test_runtime_bootstrap.py"],
    data = [":skill_bundle"],
)

py_test(
    name = "repo_contract_test",
    legacy_create_init = 0,
    main = "scripts/validate_repo_manifest.py",
    size = "small",
    srcs = ["scripts/validate_repo_manifest.py"],
    args = ["--self-test", "tinyland.repo.json"],
    data = ["tinyland.repo.json"],
)

py_test(
    name = "skill_contract_test",
    legacy_create_init = 0,
    main = "scripts/validate_skill.py",
    size = "small",
    srcs = ["scripts/validate_skill.py"],
    args = ["--allow-runfiles-symlinks", "--self-test", ".agents/skills/bulkload"],
    data = [":skill_bundle"],
)

py_test(
    name = "installer_test",
    legacy_create_init = 0,
    main = "tests/test_installer.py",
    size = "medium",
    srcs = ["tests/test_installer.py"],
    data = [
        "scripts/install_lock.py",
        "scripts/install-skill.sh",
        "scripts/validate_skill.py",
        ":skill_bundle",
    ],
)

py_test(
    name = "ci_contract_test",
    legacy_create_init = 0,
    main = "tests/test_ci_contract.py",
    size = "small",
    srcs = ["tests/test_ci_contract.py"],
    data = [
        "BUILD.bazel",
        ".bazelrc",
        ".bazelrc.flywheel",
        ".bazelversion",
        ".github/actionlint.yaml",
        ".github/actions/bulkload-public-read-ci/action.yml",
        ".github/workflows/ci.yml",
        "flake.lock",
        "flake.nix",
        "justfile",
        "justfile.flywheel",
        "scripts/ci-public-read-guard.sh",
        "tinyland.repo.json",
    ],
)

filegroup(
    name = "skill_bundle",
    srcs = glob([".agents/skills/bulkload/**"]),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        ":bazel_binary_smoke_test",
        ":bulkload_tests",
        ":ci_contract_test",
        ":custody_source_fold_tests",
        ":doctor_tests",
        ":installer_test",
        ":repo_contract_test",
        ":runtime_bootstrap_tests",
        ":skill_contract_test",
        ":wave0_perf_tests",
        ":wave2_memory_tests",
    ],
)
