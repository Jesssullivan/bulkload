"""Repository and CI contract checks; the Rust workspace builds with cargo (just rust-check)."""

load("@rules_python//python:defs.bzl", "py_test")

filegroup(
    name = "bulkload",
    srcs = glob([".agents/skills/bulkload/**", "docs/**"]) + ["README.md", "AGENTS.md"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "repo_contract_test",
    legacy_create_init = 0,
    main = "scripts/validate_repo_manifest.py",
    size = "small",
    srcs = ["scripts/validate_repo_manifest.py"],
    args = ["--self-test", "tinyland.repo.json"],
    data = ["tinyland.repo.json"],
)

py_test(
    name = "ci_contract_test",
    legacy_create_init = 0,
    main = "tests/test_ci_contract.py",
    size = "small",
    srcs = ["tests/test_ci_contract.py"],
    data = [
        "BUILD.bazel",
        ".bazelrc",
        ".bazelrc.flywheel",
        ".bazelversion",
        ".github/actionlint.yaml",
        ".github/actions/bulkload-public-read-ci/action.yml",
        ".github/workflows/ci.yml",
        "MODULE.bazel",
        "flake.lock",
        "flake.nix",
        "justfile",
        "justfile.flywheel",
        "scripts/ci-public-read-guard.sh",
        "tinyland.repo.json",
    ],
)

test_suite(
    name = "tests",
    tests = [":repo_contract_test", ":ci_contract_test"],
)
