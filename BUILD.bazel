"""Canonical build and validation graph for bulkload."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "bulkload_lib",
    srcs = glob([".agents/skills/bulkload/scripts/bulkload_lib/**/*.py"]),
    data = [
        ".agents/skills/bulkload/references/codex-private-state-policy.v3.json",
        ".agents/skills/bulkload/scripts/bulkload.py",
    ],
    imports = [".agents/skills/bulkload/scripts"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "bulkload",
    legacy_create_init = 0,
    srcs = [".agents/skills/bulkload/scripts/bulkload.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "bulkload_tests",
    legacy_create_init = 0,
    main = "tests/test_bulkload.py",
    size = "medium",
    srcs = [
        "tests/test_bulkload.py",
        "tests/unprivileged_test_main.py",
    ],
    deps = [":bulkload_lib"],
)

py_test(
    name = "bazel_binary_smoke_test",
    legacy_create_init = 0,
    main = "tests/test_bazel_binary_smoke.py",
    size = "small",
    srcs = ["tests/test_bazel_binary_smoke.py"],
    data = [":bulkload"],
)

py_test(
    name = "private_state_tests",
    legacy_create_init = 0,
    main = "tests/test_private_state.py",
    size = "medium",
    srcs = ["tests/test_private_state.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "private_apply_tests",
    legacy_create_init = 0,
    main = "tests/test_private_apply.py",
    size = "medium",
    srcs = ["tests/test_private_apply.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "private_quiescence_tests",
    legacy_create_init = 0,
    main = "tests/test_private_quiescence.py",
    size = "small",
    srcs = ["tests/test_private_quiescence.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "private_runtime_tests",
    legacy_create_init = 0,
    main = "tests/test_private_runtime.py",
    size = "small",
    srcs = ["tests/test_private_runtime.py"],
    deps = [":bulkload_lib"],
)

py_test(
    name = "runtime_bootstrap_tests",
    legacy_create_init = 0,
    main = "tests/test_runtime_bootstrap.py",
    size = "small",
    srcs = ["tests/test_runtime_bootstrap.py"],
    data = [":skill_bundle"],
)

py_test(
    name = "repo_contract_test",
    legacy_create_init = 0,
    main = "scripts/validate_repo_manifest.py",
    size = "small",
    srcs = ["scripts/validate_repo_manifest.py"],
    args = ["--self-test", "tinyland.repo.json"],
    data = ["tinyland.repo.json"],
)

py_test(
    name = "skill_contract_test",
    legacy_create_init = 0,
    main = "scripts/validate_skill.py",
    size = "small",
    srcs = ["scripts/validate_skill.py"],
    args = [
        "--allow-runfiles-symlinks",
        "--self-test",
        ".agents/skills/bulkload",
    ],
    data = [":skill_bundle"],
)

py_test(
    name = "installer_test",
    legacy_create_init = 0,
    main = "tests/test_installer.py",
    size = "small",
    srcs = ["tests/test_installer.py"],
    data = [
        "scripts/install_lock.py",
        "scripts/install-skill.sh",
        "scripts/validate_skill.py",
        ":skill_bundle",
    ],
)

py_test(
    name = "ci_contract_test",
    legacy_create_init = 0,
    main = "tests/test_ci_contract.py",
    size = "small",
    srcs = ["tests/test_ci_contract.py"],
    data = [
        "BUILD.bazel",
        ".bazelrc",
        ".bazelrc.flywheel",
        ".bazelversion",
        ".github/actionlint.yaml",
        ".github/actions/bulkload-public-read-ci/action.yml",
        ".github/workflows/ci.yml",
        "flake.lock",
        "flake.nix",
        "justfile",
        "justfile.flywheel",
        "scripts/ci-public-read-guard.sh",
        "tinyland.repo.json",
    ],
)

filegroup(
    name = "skill_bundle",
    srcs = glob([".agents/skills/bulkload/**"]),
    visibility = ["//visibility:public"],
)

test_suite(
    name = "tests",
    tests = [
        ":bazel_binary_smoke_test",
        ":bulkload_tests",
        ":ci_contract_test",
        ":installer_test",
        ":private_apply_tests",
        ":private_quiescence_tests",
        ":private_runtime_tests",
        ":private_state_tests",
        ":repo_contract_test",
        ":runtime_bootstrap_tests",
        ":skill_contract_test",
    ],
)
