{
  "schema_version": 1,
  "repo": {
    "name": "bulkload",
    "github": "Jesssullivan/bulkload",
    "description": "Manifest-first, verified repository and agent-context migration tooling"
  },
  "taxonomy": {
    "primary_role": "private-migration-tooling",
    "layers": [
      "agent-skill",
      "bazel-ssot",
      "operator-tooling"
    ]
  },
  "contracts": {
    "agent": "AGENTS.md",
    "operator": "justfile",
    "build": "BUILD.bazel",
    "design": "docs/design.md",
    "skill": ".agents/skills/bulkload/SKILL.md"
  },
  "boundaries": {
