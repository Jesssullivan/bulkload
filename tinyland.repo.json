{
  "schema_version": 2,
  "repo": {
    "name": "bulkload",
    "github": "Jesssullivan/bulkload",
    "description": "Live-host estate mover: Rust agent, wire protocol and benchmark"
  },
  "taxonomy": {
    "primary_role": "private-migration-tooling",
    "layers": [
      "agent-skill",
      "bazel-ssot",
      "gloriousflywheel-consumer",
      "operator-tooling"
    ]
  },
  "contracts": {
    "agent": "AGENTS.md",
    "operator": "justfile",
    "build": "BUILD.bazel",
    "ci": ".github/workflows/ci.yml",
    "design": "docs/design.md",
    "flywheel": "justfile.flywheel",
    "skill": ".agents/skills/bulkload/SKILL.md"
  },
  "enrollment": {
    "forgeScope": "Jesssullivan",
    "operatorOverlay": "jesssullivan-infra",
    "executionPool": "tinyland-nix",
    "substrateMode": "shared-cache-backed"
  },
  "boundaries": {
    "default_read_only": true,
    "runtime": "rust",
    "implementation_repository": "Jesssullivan/bulkload",
    "preserves_unique_state": true,
    "signals_processes": false,
    "owns_home_manager_activation": false
  }
}
